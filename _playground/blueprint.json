{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/helpmark-pink/nijiiro-hiroba-theme",
        "ref": "HEAD"
      },
      "options": {
        "activate": true
      },
      "progress": {
        "caption": "オリジナルテーマ「にじいろひろば」を読み込んでいます"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "にじいろひろば",
        "blogdescription": "神戸市東灘区の放課後等デイサービス（架空の施設です）",
        "permalink_structure": "/%postname%/",
        "timezone_string": "Asia/Tokyo",
        "date_format": "Y.m.d"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require_once get_template_directory() . '/_playground/demo-content.php';",
      "progress": {
        "caption": "デモ用のお知らせを3件登録しています"
      }
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
  ]
}
